# ===== VECTRACOM — variables d'environnement =====
# Copier vers .env puis adapter.

# PostgreSQL
POSTGRES_USER=vectracom
POSTGRES_PASSWORD=vectracom_dev
POSTGRES_DB=vectracom
POSTGRES_PORT=5434

# Redis
REDIS_PORT=6380

# Backend
BACKEND_PORT=3100
DATABASE_URL=postgres://vectracom:vectracom_dev@localhost:5434/vectracom
REDIS_URL=redis://localhost:6380

# Auth
JWT_SECRET=change-me-64-chars-minimum-en-production
JWT_EXPIRES_IN=12h

# Web admin
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# CORS (origines séparées par des virgules)
CORS_ORIGINS=http://localhost:3001

# Seed super_admin Green-T
GREEN_T_ADMIN_EMAIL=admin@green-t.sn
GREEN_T_ADMIN_PASSWORD=ChangeMe!2026
GREEN_T_ADMIN_NAME=Green-T Super Admin

# IA Vision (phases ultérieures)
GEMINI_API_KEY=
YOLO_API_URL=

# Notifications (phases ultérieures)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
EXPO_ACCESS_TOKEN=

# Remontée WhatsApp → chat + IA Vision (M4)
# Header X-Remontee-Secret sur POST /api/v1/remontee/ingest
REMONTEE_BRIDGE_SECRET=change-me-remontee-bridge-secret
REMONTEE_WHATSAPP_GROUP=Remontée

# Matrix / Dendrite (optionnel — profil docker matrix)
# MATRIX_HOMESERVER=http://localhost:8008
