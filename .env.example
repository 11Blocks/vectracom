# ===== VECTRACOM — variables d'environnement =====
# Copier vers .env puis adapter.

# PostgreSQL
POSTGRES_USER=vectracom
POSTGRES_PASSWORD=vectracom_dev
POSTGRES_DB=vectracom
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Backend
BACKEND_PORT=3000
DATABASE_URL=postgres://vectracom:vectracom_dev@localhost:5432/vectracom
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-64-chars-minimum-en-production
JWT_EXPIRES_IN=12h

# Web admin
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# CORS (origines séparées par des virgules)
CORS_ORIGINS=http://localhost:3001

# Seed super_admin Green-T
GREEN_T_ADMIN_EMAIL=admin@green-t.sn
GREEN_T_ADMIN_PASSWORD=ChangeMe!2026
GREEN_T_ADMIN_NAME=Green-T Super Admin

# IA Vision (phases ultérieures)
GEMINI_API_KEY=
YOLO_API_URL=

# Notifications (phases ultérieures)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
